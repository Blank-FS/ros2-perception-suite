# Copy to .env in this folder (gitignored) and fill in before downloading data
# from Roboflow:
#   cp model/testing/.env.example model/testing/.env

# Required. Your workspace's Private API Key: app.roboflow.com > workspace
# Settings (sidebar, bottom left) > API Keys, or go straight to
# https://app.roboflow.com/<workspace>/settings/api
ROBOFLOW_API_KEY=

# Optional defaults for model/testing/download_dataset.py, so it can run with no
# arguments. They come from the dataset URL:
#   https://app.roboflow.com/<workspace>/<project>/<version>
# Command-line flags override them.
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
